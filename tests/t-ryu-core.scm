(use-modules (srfi srfi-64)
             (srfi srfi-1)
             (ice-9 rdelim)
             (rnrs bytevectors)
             (system foreign)
             (ryu core))

(test-begin "t-ryu-core")

(define (approx= a b)
  (or (= a b)
      (<= (abs (- a b)) (* 1e-14 (max (abs a) (abs b))))))

;; Trigraphs
(test-equal "#x ??? [a?? b?" (trigraph->ascii "??=x ??? ??(a?? b?"))
(test-equal "??=??(x??)" (ascii->trigraph "#[x]"))
(test-equal "#[x]" (trigraph->ascii (ascii->trigraph "#[x]")))

;; Increment and assignment operators
(test-equal 6 (let ((x 5)) (++ x) x))
(test-equal 4 (let ((x 5)) (-- x) x))
(test-equal 8 (let ((x 5)) (+= x 3) x))
(test-equal 1 (let ((x 5)) (&= x 3) x))
(test-equal 7 (let ((x 5)) (\|= x 3) x))
(test-equal 6 (let ((x 5)) (^= x 3) x))
(test-equal 20 (let ((x 5)) (<<= x 2) x))

;; Casts
(test-equal 128 (cast-int8-to-uint8 -128))
(test-equal 255 (cast-int8-to-uint8 -1))
(test-equal -128 (cast-uint8-to-int8 128))
(test-equal -1 (cast-uint8-to-int8 255))
(test-equal 127 (cast-uint8-to-int8 127))
(test-equal 32768 (cast-int16-to-uint16 -32768))
(test-equal -1 (cast-uint32-to-int32 #xffffffff))
(test-equal #xffffffffffffffff (cast-int64-to-uint64 -1))
(test-equal -9223372036854775808 (cast-uint64-to-int64 #x8000000000000000))
(test-equal 254 (lognot-uint8 1))

;; Arithmetic
(test-equal -3 (c/ -7 2))
(test-equal -1 (c% -7 2))
(test-equal 1 (c% 7 -2))
(test-equal 2.5 (c/ 5 2.0))
(test-equal 1 (c== 0.0 -0.0))
(test-equal 0 (c== +nan.0 +nan.0))
(test-equal 1 (c!= 1 2))
(test-equal 16 (u8<< 1 4))
(test-equal 0 (u8<< 1 8))
(test-equal 1 (u8>> 16 4))
(test-equal 2 (bitand 6 3))
(test-equal 7 (bitor 6 3))
(test-equal 5 (bitxor 6 3))
(test-equal 0 (c-logical-and 1 0))
(test-equal 1 (c-logical-or 0 2))
(test-equal 0 (c-logical-or #f 0))
(test-equal 'b (c?: 0 'a 'b))
(test-equal 'a (c?: 5 'a 'b))

;; The for loop, with break and continue
(test-equal '(0 1 3 4)
  (let ((out '()))
    (for (i 0) (< i 5) (1+ i)
	 (when (= i 2) (continue))
	 (set! out (cons i out)))
    (reverse out)))
(test-equal '(0 1 2)
  (let ((out '()))
    (for (i 0) (< i 10) (1+ i)
	 (when (= i 3) (break))
	 (set! out (cons i out)))
    (reverse out)))
(test-equal 42 (for (i 0) (< i 10) (1+ i) (when (= i 3) (break 42))))
(test-equal #f (for (i 0) (< i 3) (1+ i) #t))

;; __LINE__ and __FILE__
(test-assert (integer? (__LINE__)))
(test-assert (string? (__FILE__)))

;; assert
(test-error #t (assert (= 1 2)))
(test-equal 'ok (begin (assert (= 1 1)) 'ok))

;; Complex numbers
(test-equal 1-2i (conj 1+2i))
(test-equal 3.0 (conj 3.0))
(test-equal (make-rectangular +inf.0 0.0) (cproj (make-rectangular +inf.0 1.0)))
(test-equal 1+2i (cproj 1+2i))
(test-eqv 5.0 (cabs 3+4i))
(test-assert (= 2 (creal (CMPLX 2 3))))
(test-assert (= 3 (cimag (CMPLX 2 3))))

;; Character handling
(test-equal 1 (cisalnum (char->integer #\a)))
(test-equal 0 (cisalnum (char->integer #\-)))
(test-equal 1 (cisupper (char->integer #\A)))
(test-equal 1 (cispunct (char->integer #\$)))
(test-equal 1 (cisprint (char->integer #\space)))
(test-equal 0 (cisprint (char->integer #\tab)))
(test-assert (ispunct? #\+))
(test-assert (not (isprint? #\newline)))
(test-equal (char->integer #\a) (ctolower (char->integer #\A)))
(test-equal (char->integer #\1) (ctolower (char->integer #\1)))
(test-equal -1 (ctoupper -1))		; EOF passes through

;; inttypes
(test-equal '(-3 . -1) (imaxdiv -7 2))
(test-equal '(3 . 1) (imaxdiv 7 2))

;; Floating-point classification
(test-equal 1 (cisfinite 1.0))
(test-equal 0 (cisfinite +inf.0))
(test-equal 1 (cisinf -inf.0))
(test-equal 1 (cisnan +nan.0))
(test-equal 0 (cisnan 1.0))
(test-equal 1 (cisnormal 1.0))
(test-equal 0 (cisnormal 5e-324))
(test-equal 1 (csignbit -0.0))
(test-equal 0 (csignbit 0.0))
(test-assert (signbit -2))
(test-equal -1.0 (copysign 1.0 -2.0))
(test-equal 1.0 (copysign -1.0 2.0))
(test-equal -1.0 (copysign 1.0 -0.0))
(test-assert (islessgreater -1 1))
(test-assert (not (islessgreater 1 1)))
(test-equal 0 (cislessgreater +nan.0 1.0))

;; frexp, ldexp and friends
(test-equal '(0.5 . 4) (frexp 8.0))
(test-equal '(-0.75 . 2) (frexp -3.0))
(test-equal '(0.5 . -1073) (frexp 5e-324))
(test-equal 8.0 (ldexp 0.5 4))
(test-equal 5e-324 (ldexp 1.0 -1074))
(test-equal 3 (ilogb 8.5))
(test-equal -1074 (ilogb 5e-324))
(test-equal -inf.0 (logb 0.0))
(test-equal 10.0 (log2 1024.0))
(test-equal '(0.5 . 3.0) (modf 3.5))
(test-equal '(-0.5 . -3.0) (modf -3.5))
(test-equal 3.0 (cbrt 27.0))
(test-equal -3.0 (cbrt -27.0))
(test-equal 5.0 (hypot 3.0 4.0))
(test-equal 1e300 (hypot 6e299 8e299))
(test-assert (approx= 1.0000000000000005e-15 (expm1 1e-15)))
(test-equal 9.999999999999995e-16 (log1p 1e-15))
(test-equal 3 (lround 2.5))
(test-equal -3 (lround -2.5))
(test-equal 2 (lround 2.4))
(test-equal 1.0 (fmod 7.0 3.0))
(test-equal -1.0 (fmod -7.0 3.0))
(test-equal '(1.0 . 2) (remquo 7.0 3.0))
(test-equal '(1.0 . 2) (remquo 5.0 2.0))     ; 2.5 rounds to even
(test-equal '(-1.0 . 4) (remquo 7.0 2.0))     ; 3.5 rounds to even
(test-equal '(1.0 . -2) (remquo 7.0 -3.0))
(test-equal 2.0 (fdim 5.0 3.0))
(test-equal 0.0 (fdim 3.0 5.0))
(test-equal 1.0000000000000002 (nextafter 1.0 2.0))
(test-equal 5e-324 (nextafter 0.0 1.0))
(test-equal 120.0 (tgamma 6.0))
(test-assert (approx= (sqrt (* 4 (atan 1))) (tgamma 0.5)))
(test-assert (approx= (log 120.0) (lgamma 6.0)))
(test-equal 0.0 (lgamma 1.0))
(test-equal +inf.0 (lgamma 0.0))
(test-assert (approx= 0.8427007929497149 (erf 1.0)))
(test-equal 1.0 (erf 10.0))
;; fma is rounded once
(test-equal 9.020562075079397e-19 (fma 0.1 0.1 -0.01))   ; matches glibc

;; strtod, strtol and friends
(test-equal '(1.5 . "xyz") (strtod "  1.5xyz"))
(test-equal '(16.0 . "") (strtod "0x1p4"))
(test-equal '(-3.0 . "") (strtod "-0x1.8p1"))
(test-equal '(5.0 . "") (strtod "5"))
(test-equal '(-inf.0 . "") (strtod "-inf"))
(test-equal '(+inf.0 . "x") (strtod "Infinityx"))
(test-equal '(0.0 . "abc") (strtod "abc"))
(test-equal -0.0 (car (strtod "-0")))
(test-equal 0.1 (car (strtod "0.1")))
(test-equal +inf.0 (car (strtod "1e999999999")))
(test-equal 0.10000000149011612 (car (strtof "0.1")))
(test-equal 12.5 (atof "12.5"))
(test-equal '(12 . 4) (strtol-idx "  12x"))
(test-equal '(255 . 4) (strtol-idx "0xff"))
(test-equal '(255 . 2) (strtol-idx "ff" 16))
(test-equal '(255 . 4) (strtol-idx "0xff" 16))
(test-equal '(8 . 3) (strtol-idx "010"))
(test-equal '(0 . 1) (strtol-idx "0x"))
(test-equal '(0 . 0) (strtol-idx "  +"))
(test-equal '(-42 . 3) (strtol-idx "-42"))
(test-equal 9223372036854775807 (strtol "99999999999999999999"))
(test-equal -9223372036854775808 (strtol "-99999999999999999999"))
(test-equal 18446744073709551615 (strtoul "-1"))
(test-equal 42 (atoi "42abc"))
(test-equal 0 (atoi "abc"))
(test-equal 123 (strtoimax "123"))

;; rand
(test-assert (let ((r (rand))) (and (<= 0 r) (<= r RAND_MAX))))
(test-equal (begin (srand 1) (rand)) (begin (srand 1) (rand)))

;; Memory and strings
(test-equal #vu8(1 2 3 0) (memcpy (make-bytevector 4 0) #vu8(1 2 3) 3))
(test-equal #vu8(1 2 3 0) (memmove (make-bytevector 4 0) #vu8(1 2 3) 3))
(test-equal #vu8(7 7 0) (memset (make-bytevector 3 0) 7 2))
(test-equal #vu8(255) (memset (make-bytevector 1 0) -1 1))
(test-equal 2 (memchr #vu8(1 2 3) 3 3))
(test-equal #f (memchr #vu8(1 2 3) 3 2))
(test-equal -1 (memcmp #vu8(1 2) #vu8(1 3) 2))
(test-equal "hel" (let ((s (make-string 3 #\x))) (strcpy s "hello")))
(test-equal (string #\a #\b #\nul #\nul #\x) (let ((s (make-string 5 #\x))) (strncpy s "ab" 4)))
(test-equal "abcd" (strncat "ab" "cdef" 2))
(test-equal 3 (strlen "abc"))
(test-equal 2 (strnlen "abc" 2))
(test-equal -1 (strcmp "abc" "abd"))
(test-equal 0 (strncmp "abc" "abd" 2))
(test-equal 1 (strchr "abcabc" #\b))
(test-equal 4 (strrchr "abcabc" #\b))
(test-equal 3 (strspn "abcdef" "cba"))
(test-equal 3 (strspn "abc" "abc"))
(test-equal 2 (strcspn "abcdef" "dc"))
(test-equal 3 (strcspn "abc" "x"))
(test-equal 2 (strpbrk "abcdef" "dc"))
(test-equal 2 (strstr "abcdef" "cd"))
(test-equal #f (strstr "abcdef" "xy"))
(test-equal '("a" "bc" "d")
  (let loop ((tok (strtok "  a,bc,, d " " ,")) (out '()))
    (if tok
	(loop (strtok #f " ,") (cons tok out))
	(reverse out))))

;; sprintf and snprintf
(test-equal '("x=5" 3) (let ((s #f)) (let ((n (sprintf s "x=%d" 5))) (list s n))))
(test-equal '("x=" 5) (let ((s "")) (let ((n (snprintf s 3 "x=%d" 512))) (list s n))))
(test-equal '("" 4) (let ((s "")) (let ((n (snprintf s 0 "%d" 1234))) (list s n))))

;; fgets
(test-equal '("ab\n" "cd" #f)
  (call-with-input-string "ab\ncdef"
    (lambda (port)
      (let ((s (make-string 10 #\space)))
	(list (fgets s 10 port) (fgets s 3 port)
	      (begin (read-line port) (fgets s 10 port)))))))

;; Multibyte conversion, using UTF-8
(setlocale LC_ALL "C.UTF-8")
(test-equal 2 (mblen (string->utf8 "λx")))
(test-equal #\λ (mbtowc (string->utf8 "λx")))
(test-equal #f (mbtowc #vu8(#xff)))
(test-equal "λx" (mbstowcs (string->utf8 "λx")))
(test-equal (string->utf8 "λ") (wctomb #\λ))

;; localeconv returns an evaluated alist
(test-assert (every pair? (localeconv)))
(test-assert (assq 'p-sign-posn (localeconv)))

(test-end "t-ryu-core")
